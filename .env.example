# Public origin of the deployed frontend, without a trailing slash.
# Vercel example: https://balancil.vercel.app
VITE_SITE_URL=https://example.com

# Public origin of the Laravel API, including the /api suffix.
# Render example: https://balancil-api.onrender.com/api
# Leave unset for local Vite (dev server proxies /api → Laravel :8000).
VITE_API_URL=https://api.example.com/api
